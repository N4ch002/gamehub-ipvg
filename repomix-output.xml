<file path="frontend/src/views/EquipoFormView.vue">
<script setup>
import { computed, onMounted, ref } from 'vue'
import { useRoute, useRouter } from 'vue-router'
import { actualizarEquipo, crearEquipo, obtenerEquipo } from '../services/equiposService'
import { obtenerUsuarios } from '../services/usuariosService'
import { usuario } from '../services/sesion'

const route = useRoute()
const router = useRouter()
const esEdicion = computed(() => Boolean(route.params.id))
const equipo = ref({ nombre: '', juegoPreferido: '', estado: 'Activo', integrantesIds: [] })
const capitanId = ref(usuario.value?.id)
const usuarios = ref([])
const cargando = ref(true)
const guardando = ref(false)
const error = ref('')
const mensaje = ref('')

const candidatos = computed(() => usuarios.value.filter(u => u.id !== capitanId.value))

function validar() {
  if (equipo.value.nombre.length < 3) return 'El nombre debe tener al menos 3 caracteres.'
  if (!equipo.value.juegoPreferido) return 'Debe indicar el juego preferido.'
  return ''
}

async function guardar() {
  mensaje.value = ''
  error.value = validar()
  if (error.value) return
  try {
    guardando.value = true
    if (esEdicion.value) {
      await actualizarEquipo(route.params.id, equipo.value)
    } else {
      await crearEquipo(equipo.value)
    }
    mensaje.value = 'Equipo guardado correctamente.'
    setTimeout(() => router.push('/equipos'), 1000)
  } catch (e) {
    error.value = e.message
  } finally {
    guardando.value = false
  }
}

onMounted(async () => {
  try {
    usuarios.value = await obtenerUsuarios()
    if (esEdicion.value) {
      const datos = await obtenerEquipo(route.params.id)
      capitanId.value = datos.capitanId
      equipo.value = {
        nombre: datos.nombre,
        juegoPreferido: datos.juegoPreferido,
        estado: datos.estado,
        integrantesIds: datos.integrantes.map(i => i.id).filter(id => id !== datos.capitanId),
      }
    }
  } catch (e) {
    error.value = e.message
  } finally {
    cargando.value = false
  }
})
</script>

<template>
  <section class="pagina">
    <h1>{{ esEdicion ? 'Editar equipo' : 'Nuevo equipo' }}</h1>
    <p v-if="cargando">Cargando...</p>
    <form v-else class="formulario" @submit.prevent="guardar">
      <label>Nombre del equipo</label>
      <input v-model="equipo.nombre" />
      <label>Juego preferido</label>
      <input v-model="equipo.juegoPreferido" placeholder="Valorant, EA Sports FC..." />
      <label>Estado</label>
      <select v-model="equipo.estado">
        <option>Activo</option>
        <option>Inactivo</option>
      </select>
      <label>Integrantes (el capitán se agrega automáticamente)</label>
      <div class="checks">
        <label v-for="u in candidatos" :key="u.id">
          <input v-model="equipo.integrantesIds" type="checkbox" :value="u.id" />
          {{ u.nombre }} ({{ u.alias }})
        </label>
      </div>
      <p v-if="error" class="error">{{ error }}</p>
      <p v-if="mensaje" class="correcto">{{ mensaje }}</p>
      <button :disabled="guardando">{{ guardando ? 'Guardando...' : 'Guardar equipo' }}</button>
    </form>
  </section>
</template>
</file>

<file path="frontend/src/views/EquiposView.vue">
<script setup>
import { computed, onMounted, ref } from 'vue'
import EquipoCard from '../components/EquipoCard.vue'
import { eliminarEquipo, obtenerEquipos } from '../services/equiposService'
import { esAdmin, usuario } from '../services/sesion'

const equipos = ref([])
const cargando = ref(true)
const error = ref('')
const mensaje = ref('')
const busqueda = ref('')
const juego = ref('Todos')

const juegos = computed(() => ['Todos', ...new Set(equipos.value.map(e => e.juegoPreferido))])

const equiposFiltrados = computed(() => {
  const texto = busqueda.value.toLowerCase()
  return equipos.value.filter(e =>
    e.nombre.toLowerCase().includes(texto) &&
    (juego.value === 'Todos' || e.juegoPreferido === juego.value)
  )
})

function puedeGestionar(equipo) {
  return esAdmin.value || equipo.capitanId === usuario.value?.id
}

async function cargar() {
  try {
    cargando.value = true
    error.value = ''
    equipos.value = await obtenerEquipos()
  } catch (e) {
    error.value = e.message
  } finally {
    cargando.value = false
  }
}

async function borrar(id) {
  if (!confirm('¿Eliminar este equipo? También se eliminarán sus inscripciones y partidos.')) return
  try {
    await eliminarEquipo(id)
    mensaje.value = 'Equipo eliminado correctamente.'
    await cargar()
  } catch (e) {
    error.value = e.message
  }
}

onMounted(cargar)
</script>

<template>
  <section class="pagina">
    <div class="encabezado">
      <h1>Equipos</h1>
      <RouterLink v-if="usuario" to="/equipos/nuevo" class="boton">Nuevo equipo</RouterLink>
    </div>
    <div class="filtros">
      <input v-model="busqueda" placeholder="Buscar por nombre" />
      <select v-model="juego">
        <option v-for="j in juegos" :key="j">{{ j }}</option>
      </select>
    </div>
    <p v-if="mensaje" class="correcto">{{ mensaje }}</p>
    <p v-if="cargando">Cargando equipos...</p>
    <div v-else-if="error">
      <p class="error">{{ error }}</p>
      <button @click="cargar">Reintentar</button>
    </div>
    <div v-else-if="equiposFiltrados.length" class="grid">
      <EquipoCard
        v-for="equipo in equiposFiltrados"
        :key="equipo.id"
        :equipo="equipo"
        :puede-gestionar="puedeGestionar(equipo)"
        @eliminar="borrar"
      />
    </div>
    <p v-else>No existen equipos que coincidan con la búsqueda.</p>
  </section>
</template>
</file>

